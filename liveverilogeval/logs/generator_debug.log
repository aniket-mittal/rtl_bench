module dut
(
  clk,
  q,
  d
);

  input clk;
  input d;  // 1-bit input
  output [7:0] q;
  reg [7:0] q;

  initial q = 0;

  always @(posedge clk) begin
    q <= q >> 1;
    q[7] <= d;  // Assigning 1-bit input directly to MSB of 8-bit register without width extension
  end

endmodule
MUTANT VERILOG END

