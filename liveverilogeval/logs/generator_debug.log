- 0x80000001 + 0x00000001 = 0x80000002 (-1 + 1 = -2)
- 0x80000005 + 0x00000003 = 0x80000002 (-5 + 3 = -2)
- 0x00000005 + 0x80000003 = 0x00000002 (5 + -3 = 2)
- 0x00000003 + 0x80000003 = 0x00000000 (3 + -3 = 0)
