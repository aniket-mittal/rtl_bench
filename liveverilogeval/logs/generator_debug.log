        if(count == 16'b1111_1111_1111_1111) begin
          count <= 16'b0;
        end else begin
          count <= count + 1;
        end
      end else begin
        if(count == 16'b0) begin
          count <= 16'b1111_1111_1111_1111;
        end else begin
          count <= count - 1;
        end
      end
    end
