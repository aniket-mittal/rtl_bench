      cnt <= 'b0;
    end else if(cnt == MUL2_DIV_CLK - 1) begin
      cnt <= 'b0;
    end else begin
      cnt <= cnt + 1'b1;
    end
  end

  reg clk_ave_r;

  always @(posedge clk or negedge rst_n) begin
    if(!rst_n) begin
      clk_ave_r <= 1'b0;
    end else if(cnt == 0) begin
      clk_ave_r <= 1;
    end else if(cnt == MUL2_DIV_CLK / 2) begin  // Changed from MUL2_DIV_CLK / 2 + 1
      clk_ave_r <= 1;
    end else begin
      clk_ave_r <= 0;
    end
  end

  reg clk_adjust_r;

  always @(negedge clk or negedge rst_n) begin
    if(!rst_n) begin
      clk_adjust_r <= 1'b0;
    end else if(cnt == 1) begin
      clk_adjust_r <= 1;
    end else if(cnt == MUL2_DIV_CLK / 2 + 1) begin
      clk_adjust_r <= 1;
    end else begin
      clk_adjust_r <= 0;
    end
  end

  assign clk_div = clk_adjust_r | clk_ave_r;

endmodule
