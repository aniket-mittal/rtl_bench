        cnt <= 0;
        start_cnt <= 1'b0;
        SR[15:8] <= mux_result[7:0];
        SR[0] <= CO;
      end else begin
        cnt <= cnt + 1;
        SR[15:0] <= { mux_result[6:0], SR[7:1], CO, 1'b0 };
      end
    end 
  end

  wire data_go;
  assign data_go = res_valid & res_ready;

  always @(posedge clk) begin
    res_valid <= (rst)? 1'b0 : 
                 (cnt[3])? 1'b1 : 
                 (data_go)? 1'b0 : res_valid;
  end


endmodule
MUTANT VERILOG END
