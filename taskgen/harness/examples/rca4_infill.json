  "files": {
    "rtl/rca4.v": "module rca4(input [3:0] a, input [3:0] b, input cin, output [3:0] s, output cout);\n  wire [4:0] c;\n  assign c[0] = cin;\n  genvar i;\n  generate for (i = 0; i < 4; i = i + 1) begin : g\n    [MASKED]\n  end endgenerate\n  assign cout = c[4];\nendmodule\n",
    "rtl/lib.v": "module full_adder(input a, input b, input cin, output s, output cout);\n  assign s = a ^ b ^ cin;\n  assign cout = (a & b) | (cin & (a ^ b));\nendmodule\n"
