  "hidden": {
    "reference_files": {
      "rtl/top_module.v": "module top_module(input clk, input rst_n, input en, input load, input [3:0] d,\n                  output reg [3:0] q, output wrap);\n  always @(posedge clk or negedge rst_n) begin\n    if (!rst_n) q <= 4'd0;\n    else if (load) q <= d;\n    else if (en) q <= q + 4'd1;\n  end\n  assign wrap = en & ~load & (q == 4'hf);\nendmodule\n"
    },
